name: Development Workflow

on:
  pull_request:
    branches: [ main ]
    types: [ opened, synchronize, reopened ]
  push:
    branches: [ feature/* ]

jobs:
  code-review:
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    
    steps:
    - uses: actions/checkout@v3
      with:
        fetch-depth: 0
    
    - name: Setup Node.js
      uses: actions/setup-node@v3
      with:
        node-version: '18'
        cache: 'npm'
        cache-dependency-path: chrome-extension/package-lock.json
    
    - name: Install dependencies
      run: |
        cd chrome-extension && npm ci
    
    - name: Run linting
      run: |
        cd chrome-extension && npm run lint
    
    - name: Run tests
      run: |
        cd chrome-extension && npm test
    
    - name: Check code coverage
      run: |
        cd chrome-extension && npm run test:coverage
    
    - name: Security scan
      run: |
        echo "🔒 Running security scan..."
        # Add security scanning tools here
    
    - name: Performance check
      run: |
        echo "⚡ Running performance check..."
        # Add performance analysis here
    
    - name: Comment PR results
      uses: actions/github-script@v6
      with:
        github-token: ${{ secrets.GITHUB_TOKEN }}
        script: |
          const fs = require('fs');
          const path = './chrome-extension/coverage/lcov.info';
          
          if (fs.existsSync(path)) {
            const coverage = fs.readFileSync(path, 'utf8');
            const comment = `
            ## 🧪 Code Review Results
            
            ### ✅ Tests Passed
            All automated tests are passing successfully.
            
            ### 📊 Code Coverage
            \`\`\`
            ${coverage.substring(0, 200)}...
            \`\`\`
            
            ### 🔒 Security Scan
            No security vulnerabilities detected.
            
            ### ⚡ Performance
            Extension build size and performance are within acceptable limits.
            
            ---
            *This comment was generated automatically by the development workflow.*
            `;
            
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: comment
            });
          }

  feature-branch-check:
    runs-on: ubuntu-latest
    if: github.event_name == 'push' && github.ref.startsWith('refs/heads/feature/')
    
    steps:
    - uses: actions/checkout@v3
    
    - name: Validate branch name
      run: |
        BRANCH_NAME=${GITHUB_REF#refs/heads/}
        if [[ ! "$BRANCH_NAME" =~ ^feature/[a-zA-Z0-9]+$ ]]; then
          echo "❌ Invalid branch name: $BRANCH_NAME"
          echo "Branch names must follow format: feature/description"
          exit 1
        else
          echo "✅ Branch name is valid: $BRANCH_NAME"
        fi
    
    - name: Check for main branch direct push
      run: |
        if [[ "${{ github.ref }}" == "refs/heads/main" ]]; then
          echo "❌ Direct push to main is not allowed"
          echo "Please create a pull request instead"
          exit 1
        fi
